# ===== 伺服器 =====
NODE_ENV=development
PORT=3000

# 允許跨域的來源，多筆以逗號分隔；* 表示全部（僅建議開發環境）
CORS_ORIGIN=*

# ===== 資料庫（Supabase PostgreSQL） =====
# 從 Supabase Dashboard > Connect 複製 Session pooler URI；不要提交真實連線字串。
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@<pooler-host>:5432/postgres
DB_POOL_SIZE=5

# App 已完成任務的保留時間（小時）；0 表示不自動從 App 清單隱藏
APP_COMPLETED_TASK_RETENTION_HOURS=0
